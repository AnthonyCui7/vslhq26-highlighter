# Copy to .env and fill in your own values. Never commit real secrets.

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure OpenAI (scoring, editing, agents, thumbnails)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EDIT_DEPLOYMENT=
AZURE_AUDIO_API_KEY=
AZURE_AUDIO_ENDPOINT=
AZURE_OPENAI_AUDIO_DEPLOYMENT=

# Azure AI Speech (transcription)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# Deepgram (transcription fallback)
DEEPGRAM_API_KEY=

# OpenRouter (LLM fallback)
OPENROUTER_API_KEY=

# upload-post.com (social publishing)
UPLOAD_POST_USER=
UPLOAD_POST_API_KEY=
