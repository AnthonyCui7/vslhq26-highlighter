@inherits StudioComponent

<div class="anim-fade-up flex h-[272px] shrink-0 flex-col border-t border-line bg-ink" style="animation-delay:150ms">
    @* toolbar *@
    <div class="flex items-center gap-0.5 border-b border-line bg-panel px-2.5 py-[5px]">
        @foreach (var t in SampleData.Tools)
        {
            <div @onclick="() => S.SetTool(t.Key)" title="@t.Label" class="flex h-[26px] w-[30px] cursor-pointer items-center justify-center rounded text-xs @(S.Tool == t.Key ? "bg-accent text-ink" : "bg-transparent text-muted hover:text-fg")">@t.Icon</div>
        }
        <div class="mx-[7px] h-[15px] w-px bg-line2"></div>
        <div @onclick="S.ToggleSnap" class="flex cursor-pointer items-center gap-1.5 rounded px-[9px] py-1 text-[11.5px] font-semibold hover:text-fg @(S.Snap ? "text-accent" : "text-muted")"><span class="font-mono text-[10px]">⌗</span>Snap</div>
        <div class="flex cursor-pointer items-center gap-1.5 px-[9px] py-1 text-[11.5px] font-semibold text-muted hover:text-fg"><span class="font-mono text-[10px]">±</span>Ripple</div>
        <div class="ml-auto flex items-center gap-2.5">
            <span class="cursor-pointer font-mono text-[11px] text-faint hover:text-fg">−</span>
            <div class="relative h-[3px] w-[88px] rounded-[2px] bg-well"><div class="absolute bottom-0 left-0 top-0 w-[55%] bg-muted"></div><div class="absolute -top-[3px] left-[55%] h-[9px] w-[9px] -translate-x-1 rounded-full bg-soft"></div></div>
            <span class="cursor-pointer font-mono text-[11px] text-faint hover:text-fg">+</span>
            <span class="cursor-pointer rounded-[3px] border border-line2 px-[7px] py-0.5 font-mono text-[10px] text-faint hover:text-fg">FIT</span>
        </div>
    </div>
    @* ruler + tracks share the playhead coordinate space *@
    <div class="relative flex min-h-0 flex-1 flex-col">
        <div class="flex shrink-0 border-b border-[#1E1C1A]">
            <div class="w-[118px] shrink-0 border-r border-[#1E1C1A]"></div>
            <div class="flex flex-1 pb-[3px] pt-1 font-mono text-[9px] text-faint">
                @foreach (var mark in SampleData.RulerMarks)
                {
                    <div class="flex-1 border-l border-well pl-[5px]">@mark</div>
                }
            </div>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto">
            @foreach (var tr in Tracks)
            {
                <div class="flex items-stretch border-b border-[#1A1918]" style="height:@tr.H">
                    <div class="flex w-[118px] shrink-0 items-center gap-[7px] border-r border-[#1E1C1A] bg-panel px-[9px]">
                        <span class="w-5 font-mono text-[10px] font-medium text-soft">@tr.Name</span>
                        <span class="flex h-3.5 w-4 cursor-pointer items-center justify-center rounded-[3px] border border-line2 text-[9px] text-faint hover:text-fg">@tr.Tog1</span>
                        <span class="flex h-3.5 w-4 cursor-pointer items-center justify-center rounded-[3px] border border-line2 text-[9px] text-faint hover:text-fg">@tr.Tog2</span>
                        <span class="ml-auto font-mono text-[8.5px] text-ghost">@tr.Kind</span>
                    </div>
                    <div class="relative flex-1 bg-[#131211]">
                        @foreach (var blk in tr.Blocks)
                        {
                            <div class="absolute bottom-[3px] top-[3px] cursor-pointer overflow-hidden rounded-[3px] border" style="left:@blk.L; width:@blk.W; background:@blk.Bg; border-color:@blk.Border">
                                @if (blk.ShowLabel)
                                {
                                    <div class="absolute left-1.5 top-0.5 whitespace-nowrap text-[9.5px] font-semibold" style="color:@blk.LabelColor">@blk.Label</div>
                                }
                                @if (blk.Bars is not null)
                                {
                                    <div class="absolute inset-x-[3px] inset-y-0.5 flex items-center gap-px">
                                        @foreach (var bar in blk.Bars)
                                        {
                                            <div class="flex-1 rounded-[1px]" style="height:@bar.H; background:@bar.C"></div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        @* playhead *@
        <div class="pointer-events-none absolute bottom-0 top-0 z-[5] w-[1.5px] bg-playhead left-[calc(118px_+_(100%_-_118px)_*_0.29)]">
            <div class="absolute -left-[4.5px] top-0 h-0 w-0 border-l-[5px] border-r-[5px] border-t-[6px] border-l-transparent border-r-transparent border-t-playhead"></div>
        </div>
    </div>
</div>

@code {
    IReadOnlyList<TrackInfo> Tracks => SampleData.BuildTracks(S.ActiveCaption);
}
