@inherits StudioComponent
@inject Highlighter.Web.Services.IStudioBackend Backend
@using Microsoft.AspNetCore.Components.Forms

<div class="anim-fade-up mt-3.5 rounded-lg border border-well bg-card p-4" style="animation-delay:70ms">
    <div class="flex items-center gap-[14px]">
        <div class="text-sm font-bold">Thumbnail</div>
        <div class="text-[11.5px] text-muted">@S.Thumbnails.Count generated · #@S.SelectedThumb selected</div>
        @if (S.ThumbJobRunning)
        {
            <span class="ml-auto flex items-center gap-[5px] text-[11.5px] text-accent">
                <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span> generating…
            </span>
        }
    </div>

    <div class="mt-3 flex gap-2.5 overflow-x-auto pb-1">
        @foreach (var thumb in S.Thumbnails)
        {
            <div @onclick="() => Select(thumb.Index)"
                 class="w-[168px] shrink-0 cursor-pointer overflow-hidden rounded-md border @(S.SelectedThumb == thumb.Index ? "border-accent" : "border-line2 hover:border-[#4A4638]")">
                <div class="relative flex aspect-video items-end justify-center" style="background:@thumb.Fill">
                    @if (thumb.OverlayText.Length > 0)
                    {
                        <span class="mb-2 px-1 text-center text-[13px] font-extrabold uppercase leading-[1.1] text-fg [text-shadow:0_1px_3px_rgba(0,0,0,0.7)]">@thumb.OverlayText</span>
                    }
                    @if (S.SelectedThumb == thumb.Index)
                    {
                        <span class="absolute right-1.5 top-1.5 rounded-[3px] bg-accent px-1.5 py-0.5 font-mono text-[9px] font-bold text-ink">SELECTED</span>
                    }
                </div>
                <div class="flex items-center gap-1.5 px-2 py-[7px]">
                    <span class="font-mono text-[9.5px] text-faint">#@thumb.Index</span>
                    <span class="truncate text-[11px] text-soft">@thumb.Direction</span>
                </div>
            </div>
        }

        <div @onclick="S.ToggleThumbPrompt"
             class="flex aspect-video w-[168px] shrink-0 cursor-pointer flex-col items-center justify-center gap-1.5 self-start rounded-md border border-dashed border-[#33302C] text-muted hover:border-accent hover:text-fg">
            <span class="flex h-7 w-7 items-center justify-center rounded-full border border-[#33302C] text-sm">+</span>
            <span class="text-[11.5px] font-semibold">Generate more</span>
        </div>

        <label class="flex aspect-video w-[168px] shrink-0 cursor-pointer flex-col items-center justify-center gap-1.5 self-start rounded-md border border-dashed border-[#33302C] text-muted hover:border-accent hover:text-fg">
            <span class="text-sm">⇪</span>
            <span class="text-[11.5px] font-semibold">Import your own</span>
            <InputFile OnChange="Import" class="hidden" accept="image/*" />
        </label>
    </div>

    @if (S.ThumbPromptOpen)
    {
        <div class="anim-drop-in mt-2.5 rounded-md border border-line3 bg-card2 p-3">
            <div class="mb-[7px] text-xs font-semibold text-muted">Direction for the new thumbnail <span class="font-normal text-faint">· optional</span></div>
            <textarea @bind="S.ThumbPrompt" @bind:event="oninput" placeholder="e.g. lean into the disaster — red alert colors, terrified face" class="box-border h-14 w-full resize-none rounded-md border border-line3 bg-ink px-[11px] py-2 font-sans text-[12.5px] leading-[1.5] text-fg outline-none"></textarea>
            <div class="mt-2 flex items-center justify-end gap-2">
                @if (S.ThumbError is not null)
                {
                    <span class="mr-auto text-[11px] text-[#E0705A]">@S.ThumbError</span>
                }
                <span @onclick="S.ToggleThumbPrompt" class="cursor-pointer rounded-md px-3 py-[7px] text-xs text-muted hover:text-fg">Cancel</span>
                <span @onclick="Generate" class="cursor-pointer rounded-md bg-accent px-4 py-[7px] text-xs font-bold text-ink hover:bg-accent-soft active:scale-[0.97] @(S.ThumbJobRunning ? "pointer-events-none opacity-50" : "")">Generate</span>
            </div>
        </div>
    }
</div>

@code {
    async Task Select(int index) => await Backend.SelectThumbnailAsync(index);

    async Task Generate()
    {
        if (S.ThumbJobRunning) return;
        try
        {
            await Backend.GenerateThumbnailsAsync(
                string.IsNullOrWhiteSpace(S.ThumbPrompt) ? null : S.ThumbPrompt.Trim());
        }
        catch (Exception exc)
        {
            S.SetThumbJob(false, $"Generation failed: {exc.Message}");
        }
    }

    async Task Import(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Backend.ImportThumbnailAsync(e.File.Name, buffer.ToArray());
            if (result.Contains("failed", StringComparison.OrdinalIgnoreCase))
                S.SetThumbJob(false, result);
        }
        catch (Exception exc)
        {
            S.SetThumbJob(false, $"Import failed: {exc.Message}");
        }
    }
}
