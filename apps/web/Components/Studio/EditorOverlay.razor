@inherits StudioComponent
@inject ApiClient Api

<div class="anim-rise absolute inset-0 z-40 flex flex-col bg-[#111010]" data-screen-label="Editor">

    @* Editor chrome *@
    <div class="flex h-11 shrink-0 items-center gap-3 border-b border-line bg-bar px-3.5">
        <div @onclick="S.CloseEditor" class="flex cursor-pointer items-center gap-[7px] rounded-[5px] px-[9px] py-[5px] text-[12.5px] text-muted hover:bg-elevate hover:text-fg">✕ <span>Close</span></div>
        <div class="h-4 w-px bg-line2"></div>
        <div class="min-w-0 truncate text-[13px] font-semibold">@S.ActiveClipTitle</div>
        <div class="shrink-0 text-[11px] @(S.Edit.SaveState == "Save failed" ? "text-playhead" : "text-faint")">@S.ProjectTitle · @S.Edit.SaveState.ToLowerInvariant()</div>
        <div class="ml-auto flex items-center gap-2">
            <div class="flex overflow-hidden rounded-[5px] border border-line2">
                <div @onclick="S.Edit.Undo" title="Undo" class="cursor-pointer px-[9px] py-1 text-[12.5px] leading-none hover:bg-elevate @(S.Edit.CanUndo ? "text-soft hover:text-fg" : "pointer-events-none text-ghost")">↺</div>
                <div @onclick="S.Edit.Redo" title="Redo" class="cursor-pointer border-l border-line2 px-[9px] py-1 text-[12.5px] leading-none hover:bg-elevate @(S.Edit.CanRedo ? "text-soft hover:text-fg" : "pointer-events-none text-ghost")">↻</div>
            </div>
            <div class="rounded-[5px] border border-line2 px-2.5 py-[5px] font-mono text-[11.5px] text-muted">@FormatChip</div>
            <div @onclick="() => _ = S.Edit.FlushSaveAsync()" title="Save the edit without exporting"
                 class="cursor-pointer rounded-[5px] border border-line2 px-3 py-[5px] text-[12.5px] text-soft hover:border-[#4A4638] hover:text-fg active:scale-[0.98] @(S.Edit.SaveState is "Saved" or "Saving…" ? "pointer-events-none opacity-60" : "")">
                @(S.Edit.SaveState == "Saving…" ? "Saving…" : S.Edit.SaveState == "Saved" ? "Saved ✓" : "Save")
            </div>
            <div @onclick="() => _ = S.Edit.ExportAsync()"
                 class="flex cursor-pointer items-center gap-1.5 rounded-[5px] border border-line2 px-3 py-[5px] text-[12.5px] text-soft hover:border-[#4A4638] hover:text-fg active:scale-[0.98] @(S.Edit.ExportBusy ? "pointer-events-none opacity-60" : "")">
                @if (S.Edit.ExportBusy)
                {
                    <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span>
                    <span>Exporting…</span>
                }
                else
                {
                    <span>Export</span>
                }
            </div>
            <div @onclick="() => S.OpenPublish(S.ActiveClip)" class="cursor-pointer rounded-[5px] bg-accent px-[13px] py-[5px] text-[12.5px] font-bold text-ink hover:bg-accent-soft active:scale-95">Publish</div>
        </div>
    </div>

    @if (S.Edit.ExportError is not null || S.Edit.ExportDone)
    {
        <div class="anim-drop-in flex shrink-0 items-center gap-3 border-b border-line px-3.5 py-2 text-[12px] @(S.Edit.ExportError is null ? "bg-[#1A2114] text-soft" : "bg-playhead/10 text-soft")">
            @if (S.Edit.ExportError is { } error)
            {
                <span class="min-w-0 flex-1 truncate">Export failed: @error</span>
            }
            else if (S.ActiveClip is null)
            {
                <span class="min-w-0 flex-1 truncate">Export finished — it's on the project page as a new version.</span>
            }
            else
            {
                <span class="min-w-0 flex-1 truncate">Export finished — it's in the media bin.</span>
                @if (S.Edit.ExportDoneUrl is { } url)
                {
                    <a href="@url" target="_blank" class="shrink-0 font-semibold text-accent hover:text-accent-soft">Open</a>
                }
            }
        </div>
    }

    @* Editor body *@
    <div class="flex min-h-0 flex-1">
        <MediaBin />
        <ProgramMonitor />
        <RightPanel />
    </div>

    <TimelinePanel />
</div>

@code {
    string FormatChip => S.ActiveClip is null ? "1920 × 1080" : S.ClipFormat switch
    {
        "square" => "1080 × 1080",
        "wide" => "1920 × 1080",
        _ => "1080 × 1920",
    };
}
