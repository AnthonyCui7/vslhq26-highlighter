@inherits StudioComponent

<div class="flex h-[54px] shrink-0 items-center gap-5 border-b border-line bg-bar px-6">
    <div @onclick="S.GoProjects" class="cursor-pointer text-[15px] font-extrabold leading-none tracking-[0.05em]">
        <span class="rounded-[3px] bg-accent pb-[2px] pl-[5px] pr-[5px] pt-[3px] text-ink">HIGH</span><span class="pb-[2px] pl-[3px] pt-[3px]">LIGHTER</span>
    </div>
    <div class="flex items-center gap-1.5 text-[13px] text-muted">
        <span @onclick="S.GoProjects" class="cursor-pointer hover:text-fg @(S.IsProjects ? "text-fg" : "text-muted")">Projects</span>
        @if (S.IsProject)
        {
            <span class="anim-fade-left text-faint">/</span>
            <span class="anim-fade-left font-semibold text-fg" style="animation-delay:40ms">@S.ProjectTitle</span>
        }
    </div>
    <div class="ml-auto flex items-center gap-[14px]">
        <div class="flex w-[260px] items-center gap-2 rounded-md border border-line2 bg-ink px-[11px]">
            <span class="text-xs text-faint">⌕</span>
            <input placeholder="Search projects, highlights…" class="flex-1 border-none bg-transparent py-[7px] font-sans text-[12.5px] text-fg outline-none" />
        </div>
        <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#2C2A27] text-[11px] font-bold text-soft">JD</div>
    </div>
</div>
